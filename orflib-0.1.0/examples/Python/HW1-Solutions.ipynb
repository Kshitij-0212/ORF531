   "source": [
    "Q1. Sizes of data\n",
    "\n",
    "(a) How many bits is the size of a boolean?\n",
    "Answer: 8 bits\n",
    "\n",
    "(b) How many bits is the size of a double?\n",
    "Answer: 64 bits\n"
   ]
  },
