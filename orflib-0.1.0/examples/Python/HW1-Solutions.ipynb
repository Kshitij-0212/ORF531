    "Q7. Pointers\n",
    "\n",
    "int a = 9;\n",
    "int& aref = a;\n",
    "++a;\n",
    "cout << aref;\n",
    "\n",
    "Answer:\n",
    "10\n",
    "\n",
    "Explanation:\n",
    "The pointer stores the address.\n",
    "The variable at that address is incremented."
   ]
  },
  {
   "cell_type": "raw",
   "id": "d627b36e-005f-47f6-af4e-ccd16710f412",
   "metadata": {},
   "source": [
    "Q8. Inherited Classes\n",
    "\n",
    "class A\n",
    "{\n",
    "public:\n",
    "A() { cout << 1 << endl; }\n",
    "~A() { cout << 2 << endl; }\n",
    "};\n",
    "class B : public A\n",
    "{\n",
    "public:\n",
    "B() { cout << 3 << endl; }\n",
    "~B() { cout << 4 << endl; }\n",
    "};\n",
    "int main()\n",
    "{\n",
    "B b;\n",
    "2\n",
    "return 0;\n",
    "}\n",
    "\n",
    "Answer:\n",
    "1 \n",
    "3\n",
    "4\n",
    "2\n",
    "\n",
    "Explanation:\n",
    "\n",
    "On initiation\n",
    "A is constructed\n",
    "B is constructed\n",
    "\n",
    "On main ending\n",
    "B is destroyed\n",
    "A is destroyed"
   ]
  },
  {
   "cell_type": "raw",
   "id": "abbea1ad-f7f9-4b68-945f-99ef2661f042",
   "metadata": {},
   "source": [
    "Q9. Reference Access\n",
    "\n",
    "int x = 1;\n",
    "auto check = [&]() -> bool\n",
    "{\n",
    "--x;\n",
    "if (x == 0)\n",
    "return false;\n",
    "else\n",
    "return true;\n",
    "};\n",
    "cout << check() << \" \" << x;\n",
    "\n",
    "Answer:\n",
    "0 0\n",
    "\n",
    "Explanation:\n",
    "x decrements to 0 and is globally affected.\n",
    "check returns false which is 0.\n"
   ]
  },
  {
