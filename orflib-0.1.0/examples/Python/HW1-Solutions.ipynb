   "id": "7871f53f-c9b9-4d69-bc1b-c66c61d6b5d0",
   "metadata": {},
   "source": [
    "Q10. Templates\n",
    "\n",
    "template <typename T>\n",
    "void fun(const T&x)\n",
    "{\n",
    "static int count = 0;\n",
    "cout << x << \" \" << count;\n",
    "++count;\n",
    "return;\n",
    "}\n",
    "int main()\n",
    "{\n",
    "fun<int>(1);\n",
    "cout << endl;\n",
    "fun<int>(2);\n",
    "cout << endl;\n",
    "fun<double>(1.2);\n",
    "cout << endl;\n",
    "return 0;\n",
    "}\n",
    "\n",
    "Answer:\n",
    "1 0\n",
    "2 1\n",
    "1.2 0\n",
    "Fun initializes differently for ints and longs so count increments to 1 for the second int, and 1 for the double."
   ]
  }
