   "metadata": {},
   "source": [
    "Q3. Logical Expressions\n",
    "\n",
    "bool a = true;\n",
    "bool b = false;\n",
    "int x = 10;\n",
    "int y = 5;\n",
    "int p = ((x | y) + (a + b));\n",
    "cout << p;\n",
    "\n",
    "Answer:\n",
    "16\n",
    "\n",
    "Explanation:\n",
    "10|5 gives 15\n",
    "a = 1\n",
    "b = 0\n"
   ]
  },
  {
   "cell_type": "raw",
   "id": "d3416537-2bf7-4dcc-9bbd-ec884e2643b3",
   "metadata": {},
   "source": [
    "Q4. Pre/post increment\n",
    "    \n",
    "int i = 1;\n",
    "int j = (--i)++;\n",
    "cout << i << \" \" << j;\n",
    "\n",
    "Answer:\n",
    "1  0\n",
    "\n",
    "Explanation:\n",
    "Pre increment works before assigning j putting i to 0\n",
    "j is assigned 0\n",
    "Post increment works after assigning j putting i back to 1"
   ]
  },
  {
   "cell_type": "raw",
   "id": "84098806-fdbb-4b27-b8ee-5030b0fda0ae",
   "metadata": {},
   "source": [
    "Q5. Short-circuiting Logical Operations\n",
    "\n",
    "int x{ 0 }, y{ 0 };\n",
    "if (x > 0 && ++y) x++;\n",
    "cout << x << \" \" << y;\n",
    "\n",
    "Answer:\n",
    "0 0\n",
    "x>0 is False\n",
    "++y is not evaluated\n",
    "Therefore x is not incremented, nor is y."
   ]
  },
  {
   "cell_type": "raw",
