   "source": [
    "Q2. Integer Arithmetic\n",
    "\n",
    "int i = 3;\n",
    "int l = i / -2;\n",
    "int k = i % -2;\n",
    "cout << l << \" \" << k;\n",
    "\n",
    "Answer:\n",
    "-1  1\n",
    "\n",
    "Explanation:\n",
    "l=-1\n",
    "k=1\n"
   ]
  },
